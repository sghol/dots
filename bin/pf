#!/bin/sh


# colors
bg="#000000"
fg="#cccccc"
sel="#FFC0B9"

selected=$(find ~/dev ~/dev/artanlms -maxdepth 1 -mindepth 1 -type d | dmenu -i -p "Projects" -nb $bg -nf $fg -sb $sel -sf $bg ) || exit 0

# If nothing selected, exit
[ -z "$selected" ] && exit 0

# change directory to selected project path
cd "$selected" || exit 1

# if the project folder is a Python project
[ -d ".venv" ] && source .venv/bin/activate

# Launch editor in the terminal with current path
"$TERMINAL" -- "$EDITOR" .
